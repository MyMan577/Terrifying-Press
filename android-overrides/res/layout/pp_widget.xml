<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pp_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pp_w_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/pp_w_art"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/pp_w_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pp_w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_name"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pp_w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pp_w_prev"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_prev"
        android:padding="10dp"
        android:src="@drawable/pp_w_ic_prev" />

    <ImageView
        android:id="@+id/pp_w_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_play"
        android:padding="8dp"
        android:src="@drawable/pp_w_ic_play" />

    <ImageView
        android:id="@+id/pp_w_next"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_next"
        android:padding="10dp"
        android:src="@drawable/pp_w_ic_next" />
</LinearLayout>
